# Caddyfile
# Автоматический HTTPS, reverse proxy для frontend/backend

{
    email pobiskwork@mail.ru
    # Стабильный TLS вместо on_demand_tls (избегаем проблем с лимитами Let's Encrypt)
    # Для on_demand_tls раскомментируйте ниже и настройте ask-эндпоинт
    # on_demand_tls {
    #     ask http://backend:8000/api/health
    # }
}

# Основной домен
{$DOMAIN_NAME:localhost} {
    # TLS управляется глобальной секцией (email) — Caddy сам получает сертификаты

    # 🔐 Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # 🗜️ Включить сжатие
    encode zstd gzip

    # API запросы → backend (FastAPI)
    reverse_proxy /api/* backend:8000

    # S3 pre-signed URLs (если используется локальный MinIO в dev)
    reverse_proxy /s3/* minio:9000

    # Всё остальное → frontend (nginx, порт 80)
    reverse_proxy frontend:80

    # Логирование (опционально)
    log {
        output file /var/log/caddy/access.log
        format json
    }
}
